@page "/Mensagem"
@rendermode InteractiveServer
@using System.Diagnostics

<PageTitle>Mensagem</PageTitle>

<h1>Mensagem</h1>

<button @onclick="Alternar">
    @(exibirMensagem ? "Ocultar Mensagem" : "Exibir Mensagem")
</button>

@if (exibirMensagem) {
<p>"Bem-vindo ao desenvolvimento web com .NET 10!"</p>
}

@code {
    private bool exibirMensagem = false;

    private void Alternar()
    {
        exibirMensagem = !exibirMensagem;
    }
}
